if (NOT DEFINED TEST_ROOT OR NOT DEFINED COPY_SCRIPT)
    message(FATAL_ERROR "Runtime copy test requires TEST_ROOT and COPY_SCRIPT")
endif ()

file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source files")
string(REPEAT "Runtime dependency payload\n" 160000 payload)
set(ck2 "${TEST_ROOT}/source files/CK2.runtime")
set(vxmath "${TEST_ROOT}/source files/VxMath.runtime")
set(sdl "${TEST_ROOT}/source files/SDL3.runtime")
file(WRITE "${ck2}" "${payload}")
file(WRITE "${vxmath}" "${payload}")
file(WRITE "${sdl}" "${payload}")
file(SHA256 "${ck2}" expected)

foreach (round RANGE 1 8)
    set(destination "${TEST_ROOT}/test executables ${round}")
    set(optional_runtime)
    set(names CK2.runtime VxMath.runtime)
    if (round GREATER 4)
        set(optional_runtime "-DSDL_RUNTIME=${sdl}")
        list(APPEND names SDL3.runtime)
    endif ()
    set(commands)
    foreach (writer RANGE 1 16)
        list(APPEND commands COMMAND "${CMAKE_COMMAND}"
                "-DCK2_RUNTIME=${ck2}" "-DVXMATH_RUNTIME=${vxmath}" ${optional_runtime}
                "-DDESTINATION=${destination}" -P "${COPY_SCRIPT}")
    endforeach ()
    # execute_process starts every command in the pipeline concurrently.
    execute_process(${commands} RESULTS_VARIABLE results ERROR_VARIABLE errors TIMEOUT 90)
    if (NOT results MATCHES "^0(;0)*$")
        message(FATAL_ERROR "Concurrent runtime copies failed: ${results}\n${errors}")
    endif ()
    foreach (name IN LISTS names)
        file(SHA256 "${destination}/${name}" actual)
        if (NOT actual STREQUAL expected)
            message(FATAL_ERROR "Concurrent runtime copies changed ${name}")
        endif ()
    endforeach ()
endforeach ()
