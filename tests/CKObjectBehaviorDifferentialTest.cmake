execute_process(COMMAND "${PROBE}" RESULT_VARIABLE result OUTPUT_VARIABLE actual ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Object behavior probe failed: ${result}\n${actual}\n${errors}")
endif()
string(REPLACE "\r\n" "\n" actual "${actual}")
string(FIND "${actual}" "created high=" begin)
if(begin LESS 0)
    message(FATAL_ERROR "Object behavior probe emitted no complete trace")
endif()
string(SUBSTRING "${actual}" ${begin} -1 actual)
file(READ "${FIXTURES}/object-behavior-9473e3c.txt" expected)
string(REPLACE "\r\n" "\n" expected "${expected}")
if(NOT actual STREQUAL expected)
    file(WRITE "${OUTPUT}/object-behavior-actual.txt" "${actual}")
    message(FATAL_ERROR "Native object behavior differs from CK2 9473e3c.\nExpected:\n${expected}\nActual:\n${actual}")
endif()
file(MAKE_DIRECTORY "${OUTPUT}/object-identity-files")
execute_process(COMMAND "${PROBE}" --write "${OUTPUT}/object-identity-files" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Writing object compatibility files failed")
endif()
foreach(extension nmo cmo nms)
    file(SHA256 "${FIXTURES}/identity.${extension}" before)
    file(SHA256 "${OUTPUT}/object-identity-files/identity.${extension}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "${extension} file encoding changed from CK2 9473e3c")
    endif()
endforeach()
foreach(directory "${FIXTURES}" "${OUTPUT}/object-identity-files")
    execute_process(COMMAND "${PROBE}" --read "${directory}" RESULT_VARIABLE result OUTPUT_VARIABLE actual ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Reading object compatibility files failed: ${actual}\n${errors}")
    endif()
endforeach()
message(STATUS "Native behavior and uncompressed object file bytes match CK2 9473e3c")
